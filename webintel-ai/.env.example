# Select: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Gemini (recommended low-cost default)
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional provider alternatives
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Model pricing used by the illustrative cost estimator (USD / 1M tokens).
# Update these values when changing model/provider.
MODEL_INPUT_USD_PER_MILLION=0.10
MODEL_OUTPUT_USD_PER_MILLION=0.40
MODEL_DISPLAY_NAME=Gemini 2.5 Flash-Lite

REQUEST_TIMEOUT=15
MAX_HTML_BYTES=2000000
MAX_TEXT_CHARS=18000
CACHE_TTL_HOURS=24
CACHE_DB=data/cache.sqlite3
MAX_REDIRECTS=4
